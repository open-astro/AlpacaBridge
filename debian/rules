#!/usr/bin/make -f
SHELL := /bin/bash
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk
include /usr/share/dpkg/architecture.mk

PARALLEL  ?= $(shell nproc)
BUILD_DIR := $(CURDIR)/obj-$(DEB_HOST_MULTIARCH)
STAGING   := $(CURDIR)/debian/alpacabridge

# Vendor SDK paths (arm64-only)
ifneq ($(DEB_HOST_ARCH),arm64)
  $(error AlpacaBridge supports arm64 only; DEB_HOST_ARCH=$(DEB_HOST_ARCH) is not supported)
endif
QHY_SDK_DIR        := $(CURDIR)/AlpacaCore/external/QHY/sdk_Arm64_25.09.29
ZWO_EAF_LIB_DIR    := $(CURDIR)/AlpacaCore/external/ZWO/EAF/lib/armv8
ZWO_CAMERA_LIB_DIR := $(CURDIR)/AlpacaCore/external/ZWO/ASI_Camera_SDK/lib/linux/armv8
SVBONY_LIB_DIR     := $(CURDIR)/AlpacaCore/external/SVBONY/lib/armv8
TOUPTEK_LIB_DIR    := $(CURDIR)/AlpacaCore/external/ToupTek/toupcamsdk.20260128/linux/arm64/glibc
PLAYERONE_LIB_DIR  := $(CURDIR)/AlpacaCore/external/PlayerOne/PlayerOne_Camera_SDK_Linux_V3.10.0/lib/arm64
PLAYERONE_PW_LIB_DIR := $(CURDIR)/AlpacaCore/external/PlayerOne/PlayerOne_FilterWheel_SDK_Linux_V1.2.3/lib/arm64

# Cross-compilation flags (no-op when building natively)
CMAKE_CROSS_FLAGS :=
ifneq ($(DEB_BUILD_ARCH),$(DEB_HOST_ARCH))
  CMAKE_CROSS_FLAGS += \
    -DCMAKE_SYSTEM_NAME=Linux \
    -DCMAKE_SYSTEM_PROCESSOR=$(DEB_HOST_GNU_CPU) \
    -DCMAKE_C_COMPILER=$(DEB_HOST_GNU_TYPE)-gcc \
    -DCMAKE_CXX_COMPILER=$(DEB_HOST_GNU_TYPE)-g++
endif

%:
	dh $@

override_dh_auto_configure:
	cmake -S $(CURDIR)/AlpacaHTTP -B $(BUILD_DIR) \
	  -DCMAKE_BUILD_TYPE=Release \
	  -DALPACACORE_ENABLE_ALL_VENDORS=ON \
	  -DALPACAHTTP_BUILD_TESTS=OFF \
	  -DALPACACORE_BUILD_TESTS=OFF \
	  $(CMAKE_CROSS_FLAGS)

override_dh_auto_build:
	cmake --build $(BUILD_DIR) --parallel $(PARALLEL)

override_dh_auto_install:
	# --- Server binary ---
	install -D -m 755 $(BUILD_DIR)/alpacahttp_server \
	  $(STAGING)/usr/bin/alpacabridge

	# --- Bundled vendor shared libraries ---
	install -d $(STAGING)/usr/lib/alpacabridge
	cp -a $(QHY_SDK_DIR)/usr/local/lib/libqhyccd.so* \
	  $(STAGING)/usr/lib/alpacabridge/
	# ZWO ASI Camera shared library (used by SmartGuider via zwoasi)
	cp -a $(ZWO_CAMERA_LIB_DIR)/libASICamera2.so* \
	  $(STAGING)/usr/lib/alpacabridge/
	# SVBONY Camera shared library
	cp -a $(SVBONY_LIB_DIR)/libSVBCameraSDK.so* \
	  $(STAGING)/usr/lib/alpacabridge/
	# ToupTek Camera shared library
	cp -a $(TOUPTEK_LIB_DIR)/libtoupcam.so* \
	  $(STAGING)/usr/lib/alpacabridge/
	# Player One Camera shared library (SmartGuider dlopens this directly)
	cp -a $(PLAYERONE_LIB_DIR)/libPlayerOneCamera.so* \
	  $(STAGING)/usr/lib/alpacabridge/
	# Player One Phoenix Filter Wheel shared library
	cp -a $(PLAYERONE_PW_LIB_DIR)/libPlayerOnePW.so* \
	  $(STAGING)/usr/lib/alpacabridge/

	# --- Register vendor library path with the dynamic linker ---
	install -d $(STAGING)/etc/ld.so.conf.d
	echo '/usr/lib/alpacabridge' > $(STAGING)/etc/ld.so.conf.d/alpacabridge.conf
	chmod 644 $(STAGING)/etc/ld.so.conf.d/alpacabridge.conf

	# --- QHY firmware files (usr-merge: /usr/lib, never aliased /lib) ---
	install -d $(STAGING)/usr/lib/firmware/qhy
	cp -a $(QHY_SDK_DIR)/lib/firmware/qhy/. $(STAGING)/usr/lib/firmware/qhy/

	# --- QHY fxload (FX3-capable, replaces system fxload) ---
	install -D -m 755 $(QHY_SDK_DIR)/sbin/fxload \
	  $(STAGING)/usr/sbin/fxload

	# --- Udev rules (one copy per vendor; usr-merge: /usr/lib, never aliased /lib) ---
	install -d $(STAGING)/usr/lib/udev/rules.d
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/ZWO/ASI_Camera_SDK/lib/linux/asi.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/ZWO/CAA/lib/caa.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/ZWO/EAF/lib/eaf.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/ZWO/EFW/lib/efw.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(QHY_SDK_DIR)/lib/udev/rules.d/85-qhyccd.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/SVBONY/90-ckusb.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/ToupTek/toupcamsdk.20260128/linux/udev/99-toupcam.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/PlayerOne/PlayerOne_Camera_SDK_Linux_V3.10.0/udev/99-player_one_astronomy.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	# ASIAIR Plus (RK3568): /dev/pwm-gpio-misc is created root-only by ZWO's
	# pwm_gpio.ko; this rule opens it to the gpio group (postinst guarantees
	# the group exists and enrolls the service user). The shell installers
	# pick this up via their *.rules discovery loop — the .deb previously
	# missed it, leaving the RK3568 switch EACCES-dead on a stock-kernel box.
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/ZWO/asiair-plus/99-zwo-asiair-plus.rules \
	  $(STAGING)/usr/lib/udev/rules.d/
	install -m 644 \
	  $(CURDIR)/AlpacaCore/external/oasisastro/99-astroasis-focuser.rules \
	  $(STAGING)/usr/lib/udev/rules.d/

	# --- Web UI assets ---
	install -d $(STAGING)/usr/share/alpacabridge/web
	cp -a $(CURDIR)/AlpacaHTTP/web/. $(STAGING)/usr/share/alpacabridge/web/

	# --- Runtime state directory (/var/lib, NOT /etc) ---
	# The state file (config/registered_devices.json) is deliberately NOT
	# shipped in the package: files under /var/lib are not conffiles, so a
	# shipped copy would clobber user state on every upgrade. postinst creates
	# it (and migrates any pre-3.0.1 /etc/alpacabridge state) instead.
	install -d $(STAGING)/var/lib/alpacabridge
	# Symlink web UI into the working directory for the server's CWD-relative
	# lookup (it also falls back to /usr/share/alpacabridge/web directly).
	ln -sf /usr/share/alpacabridge/web $(STAGING)/var/lib/alpacabridge/web

override_dh_auto_clean:
	rm -rf $(BUILD_DIR)

# Tell dh_shlibdeps where to find bundled proprietary shared libraries
override_dh_shlibdeps:
	dh_shlibdeps -l$(STAGING)/usr/lib/alpacabridge
