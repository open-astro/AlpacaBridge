#!/bin/bash
set -e

case "$1" in
    configure)
        # Create the alpacabridge system user if it does not exist
        if ! getent passwd alpacabridge > /dev/null 2>&1; then
            adduser --system --group \
                --no-create-home \
                --home /etc/alpacabridge \
                --gecos "AlpacaBridge Server" \
                alpacabridge
        fi

        # Grant plugdev membership so udev rules give USB device access
        if getent group plugdev > /dev/null 2>&1; then
            usermod -aG plugdev alpacabridge || true
        fi

        # Grant dialout membership for serial device access (focusers, mounts)
        if getent group dialout > /dev/null 2>&1; then
            usermod -aG dialout alpacabridge || true
        fi

        # Grant input membership for USB HID device access (ZWO focusers, filter wheels)
        if getent group input > /dev/null 2>&1; then
            usermod -aG input alpacabridge || true
        fi

        # Grant gpio membership for libgpiod GPIO access. The Switch drivers that
        # drive on-board 12V power ports (iOptron iMate, ToupTek StellaVita, ZWO
        # ASIAIR Pro / Plus Pi CM4) open /dev/gpiochip*, which the OpenAstro images
        # own root:gpio 0660 via a udev rule. Without this the service user gets
        # EACCES and Switch connect fails ("Failed to open GPIO chip ...").
        if getent group gpio > /dev/null 2>&1; then
            usermod -aG gpio alpacabridge || true
        fi

        # Create and set ownership of the working / config directory
        if [ ! -d /etc/alpacabridge ]; then
            mkdir -p /etc/alpacabridge
        fi
        chown -R alpacabridge:alpacabridge /etc/alpacabridge

        # Create log directory. systemd LogsDirectory= handles this when the
        # service starts, but having it pre-created lets the binary write logs
        # immediately on first start (and supports non-systemd execution).
        if [ ! -d /var/log/AlpacaBridge ]; then
            mkdir -p /var/log/AlpacaBridge
        fi
        chown alpacabridge:alpacabridge /var/log/AlpacaBridge
        chmod 0755 /var/log/AlpacaBridge

        # Register bundled vendor shared libraries (QHY, ZWO) with the dynamic linker
        ldconfig

        # Reload udev rules so newly installed rules take effect immediately
        if command -v udevadm > /dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger || true
        fi
        ;;
esac

#DEBHELPER#
