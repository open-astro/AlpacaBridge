#!/bin/bash
set -e

case "$1" in
    configure)
        # Create the alpacabridge system user if it does not exist
        if ! getent passwd alpacabridge > /dev/null 2>&1; then
            adduser --system --group \
                --no-create-home \
                --home /var/lib/alpacabridge \
                --gecos "AlpacaBridge Server" \
                alpacabridge
        fi

        # Grant plugdev membership so udev rules give USB device access
        if getent group plugdev > /dev/null 2>&1; then
            usermod -aG plugdev alpacabridge || true
        fi

        # Grant dialout membership for serial device access (focusers, mounts)
        if getent group dialout > /dev/null 2>&1; then
            usermod -aG dialout alpacabridge || true
        fi

        # NOTE: the service user is deliberately NOT enrolled in the `input`
        # group (it grants read access to keyboards/mice — a keylogging
        # surface). USB HID astronomy devices (ZWO focusers, filter wheels)
        # get their access from the packaged vendor udev rules instead.

        # Grant gpio membership for GPIO access. The Switch drivers that drive
        # on-board 12V power ports (iOptron iMate, ToupTek StellaVita, ZWO
        # ASIAIR Pro / Plus Pi CM4) open /dev/gpiochip*, and the ASIAIR Plus
        # RK3568 driver opens /dev/pwm-gpio-misc — all owned root:gpio 0660 by
        # udev rules (ours or the OpenAstro images'). Create the group when the
        # image doesn't ship one (e.g. ZWO's stock RK3568 kernel image, which
        # our packaged 99-zwo-asiair-plus.rules targets): without it the rule's
        # GROUP="gpio" silently falls back to root and the service user gets
        # EACCES at connect ("Failed to open ..."). Mirrors build_and_run.sh.
        groupadd -f --system gpio || true
        usermod -aG gpio alpacabridge || true

        # Runtime state lives in /var/lib/alpacabridge (the systemd unit's
        # StateDirectory/WorkingDirectory). Create it and the state file.
        mkdir -p /var/lib/alpacabridge/config

        # Migrate pre-3.0.1 state from /etc/alpacabridge (the old working
        # directory). Move, don't copy, so there is a single source of truth;
        # never overwrite state that already exists at the new location.
        if [ -f /etc/alpacabridge/config/registered_devices.json ] && \
           [ ! -f /var/lib/alpacabridge/config/registered_devices.json ]; then
            mv /etc/alpacabridge/config/registered_devices.json \
               /var/lib/alpacabridge/config/registered_devices.json
        fi
        # Very old layout shipped the file at the directory top level.
        if [ -f /etc/alpacabridge/registered_devices.json ] && \
           [ ! -f /var/lib/alpacabridge/config/registered_devices.json ]; then
            mv /etc/alpacabridge/registered_devices.json \
               /var/lib/alpacabridge/config/registered_devices.json
        fi
        # Tidy the old location (only if now empty apart from the packaged
        # web symlink); leave anything user-added alone.
        rm -f /etc/alpacabridge/web
        rmdir /etc/alpacabridge/config 2>/dev/null || true
        rmdir /etc/alpacabridge 2>/dev/null || true

        if [ ! -f /var/lib/alpacabridge/config/registered_devices.json ]; then
            echo '[]' > /var/lib/alpacabridge/config/registered_devices.json
            chmod 644 /var/lib/alpacabridge/config/registered_devices.json
        fi

        # -h/--no-dereference: /var/lib/alpacabridge/web is a symlink into
        # dpkg-owned /usr/share/alpacabridge — a plain chown -R would follow
        # it and re-chown packaged files.
        chown -R -h alpacabridge:alpacabridge /var/lib/alpacabridge

        # Create log directory. systemd LogsDirectory= handles this when the
        # service starts, but having it pre-created lets the binary write logs
        # immediately on first start (and supports non-systemd execution).
        if [ ! -d /var/log/AlpacaBridge ]; then
            mkdir -p /var/log/AlpacaBridge
        fi
        chown alpacabridge:alpacabridge /var/log/AlpacaBridge
        chmod 0755 /var/log/AlpacaBridge

        # Register bundled vendor shared libraries (QHY, ZWO) with the dynamic linker
        ldconfig

        # Reload udev rules so newly installed rules take effect immediately.
        # A bare `udevadm trigger` sends "change" events, but the vendor rules
        # (ZWO eaf/efw/caa/asi, etc.) match ACTION=="add" only — so devices
        # already plugged in at install time kept their root-only /dev nodes
        # until a replug or reboot (issue #195: EAF_ERROR_REMOVED on first
        # connect). Re-send "add" events for the device classes our rules
        # cover so they apply immediately to already-connected hardware.
        if command -v udevadm > /dev/null 2>&1; then
            udevadm control --reload-rules || true
            udevadm trigger || true
            udevadm trigger --action=add --subsystem-match=usb || true
            udevadm trigger --action=add --subsystem-match=hidraw || true
            udevadm trigger --action=add --subsystem-match=tty || true
        fi
        ;;
esac

#DEBHELPER#
