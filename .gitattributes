# Normalize line endings across platforms
* text=auto eol=lf

# Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX scripts and CMake should stay LF
*.sh text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Common binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.exe binary
