## Testing Patterns

### Pattern 1: Device Information Tests

Test all `AlpacaDriver` interface methods:

```cpp
TEST_CASE("ZWO Camera Driver - Device Information", "[zwo][camera][unit]") {
    auto driver = create_zwo_camera(0, 0);
    
    SECTION("Device number") {
        REQUIRE(driver->get_device_number() == 0);
    }
    
    SECTION("Device type") {
        REQUIRE(driver->get_device_type() == DeviceType::Camera);
    }
    
    SECTION("Name") {
        REQUIRE_FALSE(driver->get_name().empty());
        REQUIRE(driver->get_name().find("ZWO") != std::string::npos);
    }
    
    SECTION("Unique ID") {
        REQUIRE_FALSE(driver->get_unique_id().empty());
        REQUIRE(driver->get_unique_id().find("ZWO_") == 0);
    }
    
    SECTION("Description") {
        REQUIRE_FALSE(driver->get_description().empty());
    }
    
    SECTION("Driver info") {
        REQUIRE_FALSE(driver->get_driver_info().empty());
        REQUIRE(driver->get_driver_info().find("AlpacaCore") != std::string::npos);
    }
    
    SECTION("Driver version") {
        REQUIRE_FALSE(driver->get_driver_version().empty());
        // Version should be in format "X.Y.Z"
        REQUIRE(driver->get_driver_version().find('.') != std::string::npos);
    }
    
    SECTION("Interface version") {
        REQUIRE(driver->get_interface_version() >= 1);
    }
}
```

### Pattern 2: Connection State Tests

Test connection lifecycle:

```cpp
TEST_CASE("ZWO Camera Driver - Connection Management", "[zwo][camera][unit]") {
    auto driver = create_zwo_camera(0, 0);
    
    SECTION("Initial state is disconnected") {
        REQUIRE(driver->get_connected() == false);
    }
    
    SECTION("Connect when no camera available") {
        // This should throw or return false depending on implementation
        REQUIRE_THROWS_AS(driver->set_connected(true), AlpacaException);
    }
    
    SECTION("Connect and disconnect cycle") {
        // Only if hardware is available
        if (has_zwo_camera_available()) {
            driver->set_connected(true);
            REQUIRE(driver->get_connected() == true);
            
            driver->set_connected(false);
            REQUIRE(driver->get_connected() == false);
        }
    }
    
    SECTION("Double connect is idempotent") {
        if (has_zwo_camera_available()) {
            driver->set_connected(true);
            REQUIRE(driver->get_connected() == true);
            
            // Second connect should not throw
            REQUIRE_NOTHROW(driver->set_connected(true));
            REQUIRE(driver->get_connected() == true);
        }
    }
}
```

### Pattern 3: Capability Tests

Test device capabilities:

```cpp
TEST_CASE("ZWO Camera Driver - Capabilities", "[zwo][camera][unit]") {
    auto driver = create_zwo_camera(0, 0);
    
    SECTION("Can abort exposure") {
        REQUIRE(driver->get_can_abort_exposure() == true);
    }
    
    SECTION("Can stop exposure") {
        REQUIRE(driver->get_can_stop_exposure() == true);
    }
    
    SECTION("Can asymmetric bin") {
        // ZWO cameras typically support asymmetric binning
        REQUIRE(driver->get_can_asymmetric_bin() == true);
    }
    
    SECTION("Can set CCD temperature") {
        REQUIRE(driver->get_can_set_ccd_temperature() == true);
    }
    
    SECTION("Can get cooler power") {
        REQUIRE(driver->get_can_get_cooler_power() == true);
    }
}
```

### Pattern 4: Property Getter/Setter Tests

Test property accessors:

```cpp
TEST_CASE("ZWO Camera Driver - Properties", "[zwo][camera][unit]") {
    auto driver = create_zwo_camera(0, 0);
    
    if (!has_zwo_camera_available()) {
        SKIP("No ZWO camera available for testing");
    }
    
    driver->set_connected(true);
    
    SECTION("Binning") {
        driver->set_bin_x(2);
        driver->set_bin_y(2);
        REQUIRE(driver->get_bin_x() == 2);
        REQUIRE(driver->get_bin_y() == 2);
    }
    
    SECTION("CCD temperature") {
        double temp = driver->get_ccd_temperature();
        REQUIRE(temp < 50.0);  // Reasonable temperature range
        REQUIRE(temp > -50.0);
        
        driver->set_ccd_temperature(-10.0);
        // Wait for temperature to stabilize
        std::this_thread::sleep_for(std::chrono::seconds(5));
        double new_temp = driver->get_ccd_temperature();
        REQUIRE(std::abs(new_temp - (-10.0)) < 2.0);  // Within 2°C tolerance
    }
}
```

