## Testing Vendor Drivers

### Example: ZWO Camera Driver Tests

```cpp
// tests/test_zwo_camera.cpp
#include <catch2/catch_all.hpp>
#include <alpacacore/camera_driver.h>
#include <alpacacore/vendor/zwo/zwo_camera_driver.h>
#include <alpacacore/util/error_handling.h>
#include <thread>
#include <chrono>

namespace {
    // Helper function to check if hardware is available
    bool has_zwo_camera_available() {
        auto& sdk = alpacacore::vendor::zwo::ZWOSDKWrapper::instance();
        auto cameras = sdk.enumerate_cameras();
        return !cameras.empty();
    }
}

TEST_CASE("ZWO Camera Driver - Factory Function", "[zwo][camera][unit]") {
    SECTION("Create driver with valid camera ID") {
        if (!has_zwo_camera_available()) {
            SKIP("No ZWO camera available");
        }
        
        auto driver = create_zwo_camera(0, 0);
        REQUIRE(driver != nullptr);
        REQUIRE(driver->get_device_type() == DeviceType::Camera);
    }
    
    SECTION("Create driver with invalid camera ID throws") {
        REQUIRE_THROWS_AS(create_zwo_camera(0, 999), AlpacaException);
    }
}

TEST_CASE("ZWO Camera Driver - Exposure Control", "[zwo][camera][integration][hardware]") {
    if (!has_zwo_camera_available()) {
        SKIP("No ZWO camera available for hardware testing");
    }
    
    auto driver = create_zwo_camera(0, 0);
    driver->set_connected(true);
    
    SECTION("Start exposure") {
        REQUIRE_NOTHROW(driver->start_exposure(1.0, true));
        REQUIRE(driver->get_image_ready() == false);
    }
    
    SECTION("Wait for exposure to complete") {
        driver->start_exposure(0.1, true);  // Short exposure
        
        // Wait for exposure
        auto start = std::chrono::steady_clock::now();
        while (!driver->get_image_ready()) {
            std::this_thread::sleep_for(std::chrono::milliseconds(100));
            auto elapsed = std::chrono::steady_clock::now() - start;
            REQUIRE(elapsed < std::chrono::seconds(5));  // Timeout after 5s
        }
        
        REQUIRE(driver->get_image_ready() == true);
    }
    
    SECTION("Get image array") {
        driver->start_exposure(0.1, true);
        
        // Wait for exposure
        while (!driver->get_image_ready()) {
            std::this_thread::sleep_for(std::chrono::milliseconds(100));
        }
        
        auto image = driver->get_image_array();
        REQUIRE(image.rank == 2);  // 2D array
        REQUIRE(image.width > 0);
        REQUIRE(image.height > 0);
        REQUIRE_FALSE(image.data.empty());
    }
    
    SECTION("Abort exposure") {
        driver->start_exposure(10.0, true);  // Long exposure
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
        
        REQUIRE_NOTHROW(driver->abort_exposure());
        // Image should not be ready after abort
        REQUIRE(driver->get_image_ready() == false);
    }
}
```

### Example: iOptron Telescope Driver Tests

```cpp
// tests/test_ioptron_telescope.cpp
#include <catch2/catch_all.hpp>
#include <alpacacore/telescope_driver.h>
#include <alpacacore/vendor/ioptron/ioptron_telescope_driver.h>
#include <alpacacore/util/error_handling.h>

namespace {
    bool has_ioptron_mount_available() {
        // Check if mount is available via serial port or network
        // Implementation depends on your discovery mechanism
        return false;  // Placeholder
    }
}

TEST_CASE("iOptron Telescope Driver - Connection", "[ioptron][telescope][unit]") {
    ConnectionInfo conn_info;
    conn_info.type = ConnectionType::Serial;
    conn_info.serial_port = "/dev/ttyUSB0";
    conn_info.baud_rate = 9600;
    
    auto driver = create_ioptron_telescope(0, conn_info);
    
    SECTION("Initial state") {
        REQUIRE(driver->get_connected() == false);
        REQUIRE(driver->get_device_type() == DeviceType::Telescope);
    }
    
    SECTION("Connect to mount") {
        if (!has_ioptron_mount_available()) {
            SKIP("No iOptron mount available");
        }
        
        REQUIRE_NOTHROW(driver->set_connected(true));
        REQUIRE(driver->get_connected() == true);
    }
}

TEST_CASE("iOptron Telescope Driver - Position Tracking", "[ioptron][telescope][integration][hardware]") {
    if (!has_ioptron_mount_available()) {
        SKIP("No iOptron mount available for hardware testing");
    }
    
    ConnectionInfo conn_info;
    conn_info.type = ConnectionType::Serial;
    conn_info.serial_port = "/dev/ttyUSB0";
    conn_info.baud_rate = 9600;
    
    auto driver = create_ioptron_telescope(0, conn_info);
    driver->set_connected(true);
    
    SECTION("Get current position") {
        double ra = driver->get_right_ascension();
        double dec = driver->get_declination();
        
        REQUIRE(ra >= 0.0);
        REQUIRE(ra < 24.0);
        REQUIRE(dec >= -90.0);
        REQUIRE(dec <= 90.0);
    }
    
    SECTION("Set and get target coordinates") {
        driver->set_target_right_ascension(12.5);  // 12h 30m
        driver->set_target_declination(45.0);      // 45° N
        
        REQUIRE(std::abs(driver->get_target_right_ascension() - 12.5) < 0.001);
        REQUIRE(std::abs(driver->get_target_declination() - 45.0) < 0.001);
    }
    
    SECTION("Tracking state") {
        bool tracking = driver->get_tracking();
        REQUIRE(tracking == true || tracking == false);  // Valid state
        
        driver->set_tracking(true);
        REQUIRE(driver->get_tracking() == true);
        
        driver->set_tracking(false);
        REQUIRE(driver->get_tracking() == false);
    }
}
```

