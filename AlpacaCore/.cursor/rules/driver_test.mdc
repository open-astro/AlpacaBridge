## Mocking & Stubbing

### When to Mock

- **Hardware not available**: Test driver logic without physical hardware
- **Slow operations**: Speed up tests by mocking slow SDK calls
- **Error conditions**: Test error handling without triggering real errors
- **CI/CD environments**: Run tests in environments without hardware

### Pattern: Mock SDK Wrapper

Create a mock wrapper for testing:

```cpp
// tests/mocks/mock_zwo_sdk_wrapper.h
#pragma once

#include <alpacacore/vendor/zwo/zwo_sdk_wrapper.h>
#include <vector>
#include <memory>

namespace alpacacore::vendor::zwo::testing {

class MockZWOSDKWrapper : public ZWOSDKWrapper {
public:
    // Override methods to return test data
    std::vector<ZWOCameraInfo> enumerate_cameras() override {
        return mock_cameras_;
    }
    
    bool open_camera(int camera_id) override {
        if (camera_id < 0 || camera_id >= static_cast<int>(mock_cameras_.size())) {
            return false;
        }
        opened_camera_id_ = camera_id;
        return true;
    }
    
    void close_camera() override {
        opened_camera_id_ = -1;
    }
    
    bool start_exposure(int camera_id, double duration, bool light) override {
        if (opened_camera_id_ != camera_id) {
            return false;
        }
        exposure_duration_ = duration;
        exposure_light_ = light;
        exposure_in_progress_ = true;
        return true;
    }
    
    bool is_exposure_ready(int camera_id) override {
        if (!exposure_in_progress_) {
            return false;
        }
        // Simulate exposure completion after duration
        return true;  // Simplified for example
    }
    
    // Test helpers
    void set_mock_cameras(const std::vector<ZWOCameraInfo>& cameras) {
        mock_cameras_ = cameras;
    }
    
    void set_exposure_ready(bool ready) {
        exposure_in_progress_ = !ready;
    }
    
private:
    std::vector<ZWOCameraInfo> mock_cameras_;
    int opened_camera_id_ = -1;
    double exposure_duration_ = 0.0;
    bool exposure_light_ = false;
    bool exposure_in_progress_ = false;
};

} // namespace alpacacore::vendor::zwo::testing
```

### Using Mocks in Tests

```cpp
TEST_CASE("ZWO Camera Driver - Mocked SDK", "[zwo][camera][unit][mock]") {
    // Setup mock cameras
    std::vector<ZWOCameraInfo> mock_cameras = {
        {0, "ZWO ASI294MC Pro", 4144, 2816, true},
        {1, "ZWO ASI1600MM Pro", 4656, 3520, false}
    };
    
    // Inject mock (implementation depends on your design)
    // This is a conceptual example - actual implementation may vary
    
    auto driver = create_zwo_camera(0, 0);
    
    SECTION("Enumerate cameras via mock") {
        // Test with mocked SDK
        REQUIRE(driver->get_name().find("ZWO") != std::string::npos);
    }
}
```

**Note**: The actual mocking strategy depends on your wrapper design. Consider using dependency injection or a factory pattern to enable mocking.

