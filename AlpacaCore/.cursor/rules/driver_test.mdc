## Integration Testing

### Hardware Integration Tests

Mark hardware-dependent tests with `[hardware]` tag:

```cpp
TEST_CASE("ZWO Camera Driver - Full Workflow", "[zwo][camera][integration][hardware]") {
    if (!has_zwo_camera_available()) {
        SKIP("No ZWO camera available for integration testing");
    }
    
    auto driver = create_zwo_camera(0, 0);
    
    // Full workflow test
    driver->set_connected(true);
    REQUIRE(driver->get_connected() == true);
    
    // Set camera properties
    driver->set_bin_x(1);
    driver->set_bin_y(1);
    driver->set_start_x(0);
    driver->set_start_y(0);
    driver->set_num_x(driver->get_camera_x_size());
    driver->set_num_y(driver->get_camera_y_size());
    
    // Take exposure
    driver->start_exposure(1.0, true);
    
    // Wait for completion
    while (!driver->get_image_ready()) {
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }
    
    // Get image
    auto image = driver->get_image_array();
    REQUIRE(image.width > 0);
    REQUIRE(image.height > 0);
    REQUIRE_FALSE(image.data.empty());
    
    // Disconnect
    driver->set_connected(false);
    REQUIRE(driver->get_connected() == false);
}
```

### Multi-Device Integration Tests

```cpp
TEST_CASE("Multi-Device Integration - Camera and Telescope", "[integration][hardware]") {
    if (!has_zwo_camera_available() || !has_ioptron_mount_available()) {
        SKIP("Required hardware not available");
    }
    
    // Test camera and telescope working together
    auto camera = create_zwo_camera(0, 0);
    ConnectionInfo conn_info;
    conn_info.type = ConnectionType::Serial;
    conn_info.serial_port = "/dev/ttyUSB0";
    auto telescope = create_ioptron_telescope(0, conn_info);
    
    camera->set_connected(true);
    telescope->set_connected(true);
    
    // Test coordinated operations
    // (e.g., sync telescope to camera field of view)
}
```

