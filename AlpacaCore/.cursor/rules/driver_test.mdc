## Error Condition Testing

### Testing Exception Handling

```cpp
TEST_CASE("ZWO Camera Driver - Error Conditions", "[zwo][camera][unit]") {
    auto driver = create_zwo_camera(0, 0);
    
    SECTION("Start exposure when disconnected throws") {
        REQUIRE_THROWS_AS(
            driver->start_exposure(1.0, true),
            AlpacaException
        );
    }
    
    SECTION("Start exposure with negative duration throws") {
        if (has_zwo_camera_available()) {
            driver->set_connected(true);
            REQUIRE_THROWS_AS(
                driver->start_exposure(-1.0, true),
                AlpacaException
            );
        }
    }
    
    SECTION("Start exposure with zero duration throws") {
        if (has_zwo_camera_available()) {
            driver->set_connected(true);
            REQUIRE_THROWS_AS(
                driver->start_exposure(0.0, true),
                AlpacaException
            );
        }
    }
    
    SECTION("Get image when not ready throws") {
        if (has_zwo_camera_available()) {
            driver->set_connected(true);
            REQUIRE_THROWS_AS(
                driver->get_image_array(),
                AlpacaException
            );
        }
    }
    
    SECTION("Invalid camera ID throws") {
        REQUIRE_THROWS_AS(
            create_zwo_camera(0, 999),
            AlpacaException
        );
    }
}
```

### Testing Error Messages

```cpp
TEST_CASE("ZWO Camera Driver - Error Messages", "[zwo][camera][unit]") {
    auto driver = create_zwo_camera(0, 0);
    
    SECTION("Disconnected error message") {
        REQUIRE_THROWS_WITH(
            driver->start_exposure(1.0, true),
            Catch::Matchers::Contains("not connected") || 
            Catch::Matchers::Contains("Not connected")
        );
    }
    
    SECTION("Invalid exposure duration message") {
        if (has_zwo_camera_available()) {
            driver->set_connected(true);
            REQUIRE_THROWS_WITH(
                driver->start_exposure(-1.0, true),
                Catch::Matchers::Contains("duration") ||
                Catch::Matchers::Contains("exposure")
            );
        }
    }
}
```

