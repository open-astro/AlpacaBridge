## CI/CD Integration

### GitHub Actions Example

```yaml
# .github/workflows/tests.yml
name: Tests

on: [push, pull_request]

jobs:
  test:
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    
    steps:
      - uses: actions/checkout@v3
      
      - name: Install Catch2
        run: |
          # Install Catch2 (method depends on OS)
          # Linux: sudo apt-get install catch2
          # macOS: brew install catch2
          # Windows: vcpkg install catch2
      
      - name: Configure CMake
        run: |
          cmake -B build \
            -DALPACACORE_BUILD_TESTS=ON \
            -DALPACACORE_ENABLE_ZWO=ON
      
      - name: Build
        run: cmake --build build
      
      - name: Test (Unit Tests Only)
        run: |
          cd build
          ctest --output-on-failure -E "\[hardware\]"
      
      - name: Upload Test Results
        if: always()
        uses: actions/upload-artifact@v3
        with:
          name: test-results-${{ matrix.os }}
          path: build/test_results.xml
```

### Test Coverage

```bash
# Build with coverage
cmake .. -DALPACACORE_BUILD_TESTS=ON -DCMAKE_CXX_FLAGS="--coverage"
cmake --build .
ctest

# Generate coverage report (requires gcov/lcov)
lcov --capture --directory . --output-file coverage.info
genhtml coverage.info --output-directory coverage_html
```

