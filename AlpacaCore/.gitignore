# Build directories
build/
_build/
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt
!*.cmake.in
# Hand-written CMake modules (not generated output)
!/cmake/*.cmake

# Compiled files
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
**/.DS_Store
Thumbs.db

# Test results
*.gcov
*.gcda
*.gcno

# Vendored SDK allowlist (keep minimal subsets tracked)
!external/ZWO/ASI_Camera_SDK/**
!external/ZWO/CAA/**
!external/ZWO/EFW/**
!external/ZWO/EAF/**
!external/ZWO/asiair-plus/**
!external/QHY/**
!external/SVBONY/**
!external/ToupTek/**
!external/Altair/**
!external/PlayerOne/**
!external/libgpiod/**
!external/libgphoto2/**

# Not built or shipped: CMake links libqhyccd.so, debian/rules ships .so* (#1741).
external/QHY/*/usr/local/lib/*.a
external/QHY/*/usr/local/testapp/
external/QHY/*/usr/local/doc/

# Vendor SDKs - exclude all files except documentation
# Explicitly exclude .DS_Store files even in allowed directories
external/**/.DS_Store
external/**/.DS_Store?
