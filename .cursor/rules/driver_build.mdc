## CMake Configuration

### Finding the SDK Folder

Since vendor SDKs are placed directly in `external/` with varying folder names, you need to locate the SDK folder. You can either:

1. **Search for a known file** (recommended):
   ```cmake
   # Find the SDK folder by searching for a known header file
   file(GLOB_RECURSE ZWO_HEADER "${CMAKE_SOURCE_DIR}/external/*/ASICamera2.h")
   if(NOT ZWO_HEADER)
       message(FATAL_ERROR "ZWO SDK not found. Please extract SDK to external/")
   endif()
   get_filename_component(ZWO_SDK_DIR "${ZWO_HEADER}" DIRECTORY)
   get_filename_component(ZWO_SDK_DIR "${ZWO_SDK_DIR}" DIRECTORY)  # Go up from include/
   ```

2. **Use a specific folder name** (if you know it):
   ```cmake
   # If you know the exact folder name
   set(ZWO_SDK_DIR "${CMAKE_SOURCE_DIR}/external/ASICamera2_SDK")
   if(NOT EXISTS "${ZWO_SDK_DIR}/include/ASICamera2.h")
       message(FATAL_ERROR "ZWO SDK not found at ${ZWO_SDK_DIR}")
   endif()
   ```

### Vendor CMakeLists.txt Template

```cmake
# src/vendors/zwo/CMakeLists.txt

if(ALPACACORE_ENABLE_ZWO)
    # Find SDK folder by searching for header file
    file(GLOB_RECURSE ZWO_HEADER "${CMAKE_SOURCE_DIR}/external/*/ASICamera2.h")
    if(NOT ZWO_HEADER)
        message(FATAL_ERROR "ZWO SDK not found. Please extract SDK to external/")
    endif()
    get_filename_component(ZWO_SDK_DIR "${ZWO_HEADER}" DIRECTORY)
    get_filename_component(ZWO_SDK_DIR "${ZWO_SDK_DIR}" DIRECTORY)  # Go up from include/
    
    message(STATUS "Found ZWO SDK at: ${ZWO_SDK_DIR}")
    
    # Platform-specific library selection
    if(APPLE)
        set(ZWO_LIB_DIR "${ZWO_SDK_DIR}/lib/macos")
        set(ZWO_LIB_NAME "ASICamera2")
        set(ZWO_LIB_TYPE SHARED)
    elseif(UNIX)
        set(ZWO_LIB_DIR "${ZWO_SDK_DIR}/lib/linux/x64")
        set(ZWO_LIB_NAME "ASICamera2")
        set(ZWO_LIB_TYPE STATIC)
    elseif(WIN32)
        set(ZWO_LIB_DIR "${ZWO_SDK_DIR}/lib/windows/x64")
        set(ZWO_LIB_NAME "ASICamera2")
        set(ZWO_LIB_TYPE STATIC)
    endif()
    
    # Source files
    set(ZWO_SOURCES
        zwo_sdk_wrapper.cpp
        zwo_camera_driver.cpp
    )
    
    # Create vendor library
    add_library(alpacacore_zwo STATIC ${ZWO_SOURCES})
    
    # Include directories
    target_include_directories(alpacacore_zwo PRIVATE
        ${ZWO_SDK_DIR}/include
        ${CMAKE_SOURCE_DIR}/include
    )
    
    # Link SDK library
    if(ZWO_LIB_TYPE STREQUAL "STATIC")
        target_link_libraries(alpacacore_zwo PRIVATE
            ${ZWO_LIB_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}${ZWO_LIB_NAME}${CMAKE_STATIC_LIBRARY_SUFFIX}
        )
    else()
        target_link_libraries(alpacacore_zwo PRIVATE
            ${ZWO_LIB_DIR}/${CMAKE_SHARED_LIBRARY_PREFIX}${ZWO_LIB_NAME}${CMAKE_SHARED_LIBRARY_SUFFIX}
        )
    endif()
    
    # Link to main library
    # Use PRIVATE to avoid circular dependency warnings
    # The vendor library uses alpacacore headers but doesn't expose them to consumers
    target_link_libraries(alpacacore_zwo PRIVATE alpacacore)
    
    # Platform-specific settings
    if(APPLE)
        # macOS-specific settings
        set_target_properties(alpacacore_zwo PROPERTIES
            LINK_FLAGS "-F${ZWO_LIB_DIR}"
        )
    elseif(UNIX)
        # Linux-specific settings
        target_link_directories(alpacacore_zwo PRIVATE ${ZWO_LIB_DIR})
    endif()
endif()
```

### Main CMakeLists.txt Integration

After creating your vendor's `CMakeLists.txt`, you must integrate it into the main `CMakeLists.txt` file. This requires **4 updates** in specific locations:

#### Step 1: Add Option Flag

Add the vendor option flag in the "Build options" section (around line 9-14):

```cmake
# Build options
option(ALPACACORE_BUILD_TESTS "Build unit tests" ON)
option(ALPACACORE_ENABLE_ALL_VENDORS "Enable all vendor drivers" OFF)
option(ALPACACORE_ENABLE_ZWO "Enable ZWO vendor support" OFF)
option(ALPACACORE_ENABLE_QHY "Enable QHY vendor support" OFF)
option(ALPACACORE_ENABLE_IOPTRON "Enable iOptron vendor support" OFF)
option(ALPACACORE_ENABLE_NEWVENDOR "Enable NewVendor support" OFF)  # ← Add this
```

**Replace `NEWVENDOR` with your vendor name (uppercase).**

#### Step 2: Add to ENABLE_ALL_VENDORS Block

Update the `ALPACACORE_ENABLE_ALL_VENDORS` conditional block (around line 16-23):

```cmake
# If ALPACACORE_ENABLE_ALL_VENDORS is set, enable all implemented vendor drivers
# Note: Only enable vendors that are actually implemented (have source files)
if(ALPACACORE_ENABLE_ALL_VENDORS)
    # ZWO and QHY are not yet implemented, so don't enable them
    # set(ALPACACORE_ENABLE_ZWO ON)
    # set(ALPACACORE_ENABLE_QHY ON)
    set(ALPACACORE_ENABLE_IOPTRON ON)
    set(ALPACACORE_ENABLE_NEWVENDOR ON)  # ← Add this (only if implemented)
endif()
```

**Important**: Only add vendors that are fully implemented. Comment out or remove vendors that aren't ready yet.

#### Step 3: Add Conditional Subdirectory Inclusion

Add the vendor subdirectory inclusion in the "Vendor support" section (around line 85-111):

```cmake
# Vendor support (conditional)
# Only add subdirectories for vendors that are actually implemented
if(ALPACACORE_ENABLE_ZWO)
    # ZWO not yet implemented - skip for now
    # add_subdirectory(src/vendors/zwo)
    # if(TARGET alpacacore_zwo)
    #     target_link_libraries(alpacacore PRIVATE alpacacore_zwo)
    # endif()
    message(WARNING "ZWO vendor support is not yet implemented")
endif()

if(ALPACACORE_ENABLE_QHY)
    # QHY not yet implemented - skip for now
    # add_subdirectory(src/vendors/qhy)
    # if(TARGET alpacacore_qhy)
    #     target_link_libraries(alpacacore PRIVATE alpacacore_qhy)
    # endif()
    message(WARNING "QHY vendor support is not yet implemented")
endif()

if(ALPACACORE_ENABLE_IOPTRON)
    add_subdirectory(src/vendors/ioptron)
    if(TARGET alpacacore_ioptron)
        target_link_libraries(alpacacore PRIVATE alpacacore_ioptron)
    endif()
endif()

# ← Add this block for your new vendor
if(ALPACACORE_ENABLE_NEWVENDOR)
    add_subdirectory(src/vendors/newvendor)
    if(TARGET alpacacore_newvendor)
        target_link_libraries(alpacacore PRIVATE alpacacore_newvendor)
    endif()
endif()
```

**Replace `newvendor` with your vendor name (lowercase) and `NEWVENDOR` with uppercase.**

#### Step 4: Add Installation Rules

Add installation rules in the "Installation" section (around line 130-156):

```cmake
# Install vendor libraries if they exist
if(ALPACACORE_ENABLE_ZWO AND TARGET alpacacore_zwo)
    install(TARGETS alpacacore_zwo
        EXPORT AlpacaCoreTargets
        LIBRARY DESTINATION lib
        ARCHIVE DESTINATION lib
        RUNTIME DESTINATION bin
    )
endif()

if(ALPACACORE_ENABLE_QHY AND TARGET alpacacore_qhy)
    install(TARGETS alpacacore_qhy
        EXPORT AlpacaCoreTargets
        LIBRARY DESTINATION lib
        ARCHIVE DESTINATION lib
        RUNTIME DESTINATION bin
    )
endif()

if(ALPACACORE_ENABLE_IOPTRON AND TARGET alpacacore_ioptron)
    install(TARGETS alpacacore_ioptron
        EXPORT AlpacaCoreTargets
        LIBRARY DESTINATION lib
        ARCHIVE DESTINATION lib
        RUNTIME DESTINATION bin
    )
endif()

# ← Add this block for your new vendor
if(ALPACACORE_ENABLE_NEWVENDOR AND TARGET alpacacore_newvendor)
    install(TARGETS alpacacore_newvendor
        EXPORT AlpacaCoreTargets
        LIBRARY DESTINATION lib
        ARCHIVE DESTINATION lib
        RUNTIME DESTINATION bin
    )
endif()
```

#### Integration Checklist

When adding a new vendor driver, ensure you've completed all 4 steps:

- [ ] **Step 1**: Added `option(ALPACACORE_ENABLE_<VENDOR> ...)` in Build options section
- [ ] **Step 2**: Added `set(ALPACACORE_ENABLE_<VENDOR> ON)` in ENABLE_ALL_VENDORS block (if implemented)
- [ ] **Step 3**: Added `add_subdirectory()` and `target_link_libraries()` in Vendor support section
- [ ] **Step 4**: Added `install(TARGETS ...)` in Installation section

**Note**: AlpacaHTTP automatically gets all enabled vendors through its link to `alpacacore`, so no changes are needed in AlpacaHTTP's CMakeLists.txt. However, if your application code uses vendor-specific headers directly, you'll need `#ifdef ALPACACORE_ENABLE_<VENDOR>` guards (see `examples/simple_server/main.cpp` for examples).

